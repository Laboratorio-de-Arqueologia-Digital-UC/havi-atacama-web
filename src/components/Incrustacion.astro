---
import { t, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
  tipo: 'arcgis' | 'sketchfab';
  url: string;
  titulo: string;
}
const { lang, tipo, url, titulo } = Astro.props;

// Sketchfab: acepta el enlace de la página del modelo y lo convierte al visor incrustable.
function urlVisor(): string {
  if (tipo === 'sketchfab') {
    if (url.includes('/embed')) return url;
    const id = url.match(/([0-9a-f]{32})(?:[/?#]|$)/i)?.[1];
    return id ? `https://sketchfab.com/models/${id}/embed` : url;
  }
  return url;
}
const visor = urlVisor();
const origen = new URL(visor).hostname.replace(/^www\./, '');
---

<figure class="incrustacion">
  <div class="caja" data-visor={visor} data-titulo={titulo}>
    <button type="button" class="cargar">
      <span class="accion">{tipo === 'arcgis' ? t(lang, 'cargarMapa') : t(lang, 'cargarModelo')}</span>
      <span class="aviso">{t(lang, 'aviso3ros')} {origen}</span>
    </button>
  </div>
  <figcaption class="pie">{titulo}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.incrustacion .caja').forEach((caja) => {
    caja.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = caja.dataset.visor!;
      iframe.title = caja.dataset.titulo!;
      iframe.loading = 'lazy';
      iframe.allow = 'fullscreen; xr-spatial-tracking';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      caja.replaceChildren(iframe);
    });
  });
</script>

<style>
  .incrustacion {
    margin: 32px 0;
  }
  .caja {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--roca-2);
    border: 1px solid var(--linea);
  }
  .caja :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .cargar {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 6px;
    width: 100%;
    border: 0;
    background: transparent;
    font-family: var(--sans);
    color: var(--hollin);
    cursor: pointer;
  }
  .accion {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--blanco);
    background: var(--azul);
    padding: 12px 20px;
    justify-self: center;
  }
  .cargar:hover .accion {
    background: var(--magenta);
  }
  .aviso {
    font-size: 0.85rem;
    color: var(--gris);
  }
</style>
