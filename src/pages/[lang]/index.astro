---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Realce from '../../components/Realce.astro';
import Figura from '../../components/Figura.astro';
import ListaAvances from '../../components/ListaAvances.astro';
import { campo, ruta, t, type Idioma } from '../../lib/i18n';
import { rutasIdioma } from '../../lib/rutas';

export const getStaticPaths = rutasIdioma;
const lang = Astro.params.lang as Idioma;
const d = (await getEntry('inicio', 'inicio'))!.data;
const avances = (await getCollection('avances', (a) => !a.data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);
const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);
const desfases = ['0', 'clamp(0px, 5vw, 56px)', 'clamp(0px, 10vw, 120px)'];
const proporciones = ['4/3', '1/1', '3/4'];
---

<Base lang={lang} titulo={campo(d, 'titulo', lang)} descripcion={campo(d, 'bajada', lang)} actual="inicio">
  <section class="envoltura intro">
    <h1>{campo(d, 'titulo', lang)}</h1>
    <p class="bajada">{campo(d, 'bajada', lang)}</p>
  </section>

  <Realce lang={lang} natural={d.realce_natural} realzada={d.realce_dstretch} alt={campo(d, 'realce_alt', lang)} credito={d.realce_credito} />

  <section class="envoltura seccion">
    <p class="prosa descripcion">{campo(d, 'descripcion', lang)}</p>
  </section>

  <section class="envoltura soportes" aria-labelledby="t-soportes">
    <h2 id="t-soportes"><a href={ruta(lang, 'soportes')}>{t(lang, 'tresSoportes')}</a></h2>
    <div class="rejilla">
      {
        d.soportes.map((s, i) => (
          <div style={`margin-top:${desfases[i]}`}>
            <Figura
              src={s.imagen}
              alt={campo(s, 'alt', lang)}
              etiqueta={campo(s, 'nombre', lang)}
              texto={campo(s, 'texto', lang)}
              credito={s.credito}
              proporcion={proporciones[i]}
              posicion={i === 0 ? 'left center' : 'center'}
              anchos="(max-width: 900px) 100vw, 40vw"
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="banda seccion" aria-labelledby="t-pasos">
    <div class="envoltura">
      <h2 id="t-pasos"><a href={ruta(lang, 'metodologia')}>{t(lang, 'pasos')}</a></h2>
      <ol class="pasos" role="list">
        {
          d.pasos.map((p, i) => (
            <li>
              <span class="numero sans" aria-hidden="true">{i + 1}</span>
              <h3>{campo(p, 'titulo', lang)}</h3>
              <p>{campo(p, 'texto', lang)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="envoltura seccion" aria-labelledby="t-avances">
    <h2 id="t-avances" class="titulo-seccion">{t(lang, 'ultimos')}</h2>
    <ListaAvances lang={lang} avances={avances} />
    <p class="sans mas"><a href={ruta(lang, 'avances')}>{t(lang, 'todos')}</a></p>
  </section>

  <section class="envoltura equipo-breve" aria-labelledby="t-equipo">
    <h2 id="t-equipo" class="titulo-seccion"><a href={ruta(lang, 'equipo')}>{lang === 'es' ? 'Equipo' : 'Team'}</a></h2>
    <ul role="list">
      {
        equipo.map((p) => (
          <li>
            {p.data.foto && <Image src={p.data.foto} alt="" width={72} densities={[1, 2]} format="webp" class="foto" />}
            <p class="sans">
              <strong>{p.data.nombre}</strong>
              <br />
              <span class="secundario">{campo(p.data, 'rol', lang)}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px 56px;
    align-items: end;
    padding-block: 32px 40px;
  }
  .intro .bajada {
    margin: 0;
  }
  .descripcion {
    font-size: 1.3rem;
    line-height: 1.55;
    margin: 0;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--magenta);
  }
  .soportes {
    padding-bottom: clamp(56px, 8vw, 104px);
  }
  .soportes h2 {
    margin-bottom: 40px;
    max-width: 18ch;
  }
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
    gap: 24px;
    align-items: start;
  }
  .pasos {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 48px;
  }
  .numero {
    display: block;
    font-weight: 800;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--magenta);
    margin-bottom: 8px;
  }
  .pasos h3 {
    margin-bottom: 8px;
  }
  .pasos p {
    margin: 0;
  }
  .titulo-seccion {
    margin-bottom: 24px;
  }
  .mas {
    font-weight: 600;
    margin-top: 24px;
  }
  .equipo-breve {
    padding-bottom: clamp(56px, 8vw, 104px);
  }
  .equipo-breve ul {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 28px;
  }
  .equipo-breve li {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .equipo-breve .foto {
    border-radius: 50%;
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
  }
  .equipo-breve p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.35;
  }
  @media (max-width: 900px) {
    .intro,
    .rejilla,
    .pasos {
      grid-template-columns: 1fr;
    }
    .rejilla > div {
      margin-top: 0 !important;
    }
    .equipo-breve ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .equipo-breve ul {
      grid-template-columns: 1fr;
    }
  }
</style>
