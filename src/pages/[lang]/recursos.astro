---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PaginaGenerica from '../../components/PaginaGenerica.astro';
import { campo, fecha, t, type Idioma } from '../../lib/i18n';
import { rutasIdioma } from '../../lib/rutas';

export const getStaticPaths = rutasIdioma;
const lang = Astro.params.lang as Idioma;
const datos = (await getEntry('paginas', 'recursos'))!.data;
const recursos = (await getCollection('recursos')).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
---

<Base lang={lang} titulo={campo(datos, 'titulo', lang)} descripcion={campo(datos, 'bajada', lang)} actual="recursos">
  <PaginaGenerica lang={lang} datos={datos}>
    <section class="envoltura seccion lista-recursos">
      {
        recursos.length === 0 ? (
          <p class="secundario sans">{t(lang, 'sinRecursos')}</p>
        ) : (
          <ul role="list">
            {recursos.map((r) => (
              <li>
                <p class="meta sans secundario num">
                  {t(lang, r.data.tipo)} · {fecha(r.data.fecha, lang)}
                </p>
                <h2>{r.data.enlace ? <a href={r.data.enlace}>{campo(r.data, 'titulo', lang)}</a> : campo(r.data, 'titulo', lang)}</h2>
                {campo(r.data, 'descripcion', lang) && <p>{campo(r.data, 'descripcion', lang)}</p>}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </PaginaGenerica>
</Base>

<style>
  .lista-recursos {
    padding-top: 0;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 72ch;
  }
  li {
    border-top: 1px solid var(--linea);
    padding-block: 24px;
  }
  h2 {
    font-size: 1.4rem;
    margin: 4px 0 8px;
  }
  .meta {
    margin: 0;
    font-size: 0.875rem;
  }
</style>
