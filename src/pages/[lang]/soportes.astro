---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PaginaGenerica from '../../components/PaginaGenerica.astro';
import Figura from '../../components/Figura.astro';
import { campo, type Idioma } from '../../lib/i18n';
import { rutasIdioma } from '../../lib/rutas';

export const getStaticPaths = rutasIdioma;
const lang = Astro.params.lang as Idioma;
const datos = (await getEntry('paginas', 'soportes'))!.data;
const inicio = (await getEntry('inicio', 'inicio'))!.data;
---

<Base lang={lang} titulo={campo(datos, 'titulo', lang)} descripcion={campo(datos, 'bajada', lang)} actual="soportes">
  <PaginaGenerica lang={lang} datos={datos}>
    <section class="banda seccion">
      <div class="envoltura soportes">
        {
          inicio.soportes.map((s) => (
            <article>
              <Figura src={s.imagen} alt={campo(s, 'alt', lang)} credito={s.credito} proporcion="4/3" anchos="(max-width: 900px) 100vw, 33vw" />
              <h2>{campo(s, 'nombre', lang)}</h2>
              <p>{campo(s, 'texto', lang)}</p>
            </article>
          ))
        }
      </div>
    </section>
  </PaginaGenerica>
</Base>

<style>
  .soportes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 32px;
  }
  .soportes h2 {
    font-size: 1.75rem;
    margin: 20px 0 8px;
  }
  @media (max-width: 900px) {
    .soportes {
      grid-template-columns: 1fr;
    }
  }
</style>
